# Copy to .env (git-ignored) and fill in. Never commit real values.
ELASTIC_URL=
ELASTIC_USER=elastic
ELASTIC_PASSWORD=
# Elastic Cloud Serverless uses an API key instead of the elastic user's password.
ELASTIC_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
DASH0_AUTH_TOKEN=
# Optional: Dash0 dataset name (default dataset if blank).
DASH0_DATASET=
